<?xml version="1.0" encoding="utf-8"?>
<!--
  Where the head-less Rhino comes from. Edit RhinoSystemDirectory if Rhino is installed
  somewhere else; Rhino.Testing needs Rhino 8 or newer. The build reads this same path
  to reference the Rhino SDK, so it is the only place it is written down.

  LoadEto is on because Alpaca4d references Eto.Forms (the licence dialog and the
  settings UI); nothing opens a window in a test run, but the assembly has to resolve.

  LoadGrasshopper is off, and SetupFixture.LoadGrasshopperHeadless does that job
  instead - Rhino.Testing's own Grasshopper loader cannot finish on Rhino 8.35. Eto and
  the RDK, which that setting would have brought in, are asked for by name here.
-->
<Settings>
  <RhinoSystemDirectory>C:\Program Files\Rhino 8\System</RhinoSystemDirectory>
  <CreateRhinoDoc>true</CreateRhinoDoc>
  <CreateRhinoView>false</CreateRhinoView>
  <LoadEto>true</LoadEto>
  <LoadRDK>true</LoadRDK>
  <LoadLegacyIronPython>false</LoadLegacyIronPython>
  <LoadGrasshopper>false</LoadGrasshopper>
</Settings>
