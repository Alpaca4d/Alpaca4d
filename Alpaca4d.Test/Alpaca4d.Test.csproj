<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================
       Alpaca4d component test-bench.
       Solves Grasshopper components against a head-less Rhino, with no canvas open.
       Windows only - see README.md.
       ========================================== -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Alpaca4d.Testing</RootNamespace>
    <AssemblyName>Alpaca4d.Test</AssemblyName>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\.runsettings</RunSettingsFilePath>
    <!-- Obsolete components are part of what needs testing, and the Rhino SDK packages
         carry a known-vulnerability advisory we do not control. -->
    <NoWarn>$(NoWarn);CS0612;CS0618;NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Rhino.Testing" Version="8.0.28-beta" />
    <!-- Rhino.Testing pulls in Rhino.Inside, which drags the Rhino 8.0 SDK packages
         along as compile references. This project compiles against the installed Rhino
         instead (see ReferenceInstalledRhino below), and having both on the compiler
         command line makes every RhinoCommon and Grasshopper type ambiguous. -->
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="all" />
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alpaca.Core\Alpaca4d.Core.csproj" />
    <ProjectReference Include="..\Alpaca4d.Gh\Alpaca4d.Gh.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Rhino.Testing.Configs.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include=".runsettings" />
    <None Include="Approved\ComponentApi.approved.txt" />
    <None Include="README.md" />
  </ItemGroup>

  <!-- ==========================================
       The Rhino SDK: compiled against the installed Rhino, and bound to it at run time
       without ever being copied next to the test binary.

       Both halves are load-bearing, and they pull in opposite directions:

       * NUnit walks this assembly's types before any fixture runs, long before
         anything has started Rhino. A Rhino SDK assembly the CLR cannot find at that
         point fails the walk, and the run reports zero tests with nothing but
         "NUnit failed to load" to go on.
       * but the assemblies must not be copied here to satisfy that. The application
         base is probed first, so a copy is what Rhino itself would then load: a
         RhinoCommon from a different Rhino 8 build binds happily and throws
         EntryPointNotFoundException on the first P/Invoke into the installed
         rhcommon_c, and a Grasshopper.dll outside the plug-in folder never finishes
         starting up.

       A codeBase in the test assembly's config settles both: the CLR loads them
       straight out of the Rhino installation, in the discovery phase and afterwards,
       and the files stay where Rhino expects them. The version a codeBase needs is
       whatever Rhino is installed, so the config entries are written at build time.

       Rhino.Testing.Configs.xml stays the one place the Rhino location is written
       down - everything below is read out of it.
       ========================================== -->
  <Target Name="ReferenceInstalledRhino" BeforeTargets="ResolveAssemblyReferences">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Rhino.Testing.Configs.xml"
             Query="/Settings/RhinoSystemDirectory/text()">
      <Output TaskParameter="Result" PropertyName="RhinoSystemDirectory" />
    </XmlPeek>

    <PropertyGroup>
      <GrasshopperPluginDirectory>$(RhinoSystemDirectory)\..\Plug-ins\Grasshopper</GrasshopperPluginDirectory>
    </PropertyGroup>

    <Error Condition="!Exists('$(RhinoSystemDirectory)\RhinoCommon.dll')"
           Text="No Rhino at '$(RhinoSystemDirectory)'. Alpaca4d.Test needs Rhino 8 or newer installed; point RhinoSystemDirectory in Rhino.Testing.Configs.xml at its System folder." />

    <ItemGroup>
      <InstalledRhinoSdk Include="$(RhinoSystemDirectory)\RhinoCommon.dll" />
      <InstalledRhinoSdk Include="$(GrasshopperPluginDirectory)\Grasshopper.dll" />
      <InstalledRhinoSdk Include="$(GrasshopperPluginDirectory)\GH_IO.dll" />

      <Reference Include="@(InstalledRhinoSdk->'%(Filename)')">
        <HintPath>%(InstalledRhinoSdk.FullPath)</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <UsingTask TaskName="WriteRhinoCodeBase" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ConfigFile ParameterType="System.String" Required="true" />
      <Assemblies ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Reflection" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        XNamespace asm = "urn:schemas-microsoft-com:asm.v1";

        XDocument config = File.Exists(ConfigFile)
            ? XDocument.Load(ConfigFile)
            : new XDocument(new XElement("configuration"));

        XElement runtime = config.Root.Element("runtime");
        if (runtime == null) config.Root.Add(runtime = new XElement("runtime"));

        foreach (ITaskItem item in Assemblies)
        {
            string path = item.GetMetadata("FullPath");
            AssemblyName name = AssemblyName.GetAssemblyName(path);
            string token = string.Concat(name.GetPublicKeyToken().Select(b => b.ToString("x2")));

            // The binding redirect matters as much as the codeBase: Alpaca4d.Gh is
            // built against the Rhino 7 SDK, and asks for those versions by name.
            XElement dependent = runtime.Elements(asm + "assemblyBinding")
                                        .Elements(asm + "dependentAssembly")
                                        .FirstOrDefault(d => (string)d.Element(asm + "assemblyIdentity")
                                                                      .Attribute("name") == name.Name);

            if (dependent == null)
            {
                dependent = new XElement(asm + "dependentAssembly",
                    new XElement(asm + "assemblyIdentity",
                        new XAttribute("name", name.Name),
                        new XAttribute("publicKeyToken", token),
                        new XAttribute("culture", "neutral")));

                runtime.Add(new XElement(asm + "assemblyBinding", dependent));
            }

            dependent.Elements(asm + "bindingRedirect").Remove();
            dependent.Elements(asm + "codeBase").Remove();

            dependent.Add(new XElement(asm + "bindingRedirect",
                new XAttribute("oldVersion", "0.0.0.0-" + name.Version),
                new XAttribute("newVersion", name.Version.ToString())));

            dependent.Add(new XElement(asm + "codeBase",
                new XAttribute("version", name.Version.ToString()),
                new XAttribute("href", new Uri(path).AbsoluteUri)));

            Log.LogMessage(MessageImportance.Low, "Bound " + name.Name + " " + name.Version + " to " + path);
        }

        config.Save(ConfigFile);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="BindRhinoSdkToInstalledRhino" AfterTargets="Build"
          DependsOnTargets="ReferenceInstalledRhino">
    <WriteRhinoCodeBase ConfigFile="$(OutDir)$(TargetFileName).config"
                        Assemblies="@(InstalledRhinoSdk)" />
  </Target>

</Project>
